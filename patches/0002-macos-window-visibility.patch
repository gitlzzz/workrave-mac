+
+#ifndef WORKRAVE_UI_QT_MACOS_WINDOW_HH
+#define WORKRAVE_UI_QT_MACOS_WINDOW_HH
+
+#include <qwindowdefs.h> // WId
+
+namespace MacOSWindow
+{
+  // Keep a window visible even when Workrave is not the active application.
+  // macOS hides Qt::Tool windows (NSPanel) on deactivation, which makes the
+  // timer box vanish whenever another app is focused.
+  void set_hides_on_deactivate(WId winid, bool hides);
+
+  // Allow a window to appear on every Space and above full-screen apps, and
+  // raise its level so breaks/preludes are not hidden behind other windows.
+  void set_all_spaces_and_raised(WId winid);
+} // namespace MacOSWindow
+
+#endif // WORKRAVE_UI_QT_MACOS_WINDOW_HH
diff --git a/ui/app/toolkits/qt/platforms/macos/MacOSWindow.mm b/ui/app/toolkits/qt/platforms/macos/MacOSWindow.mm
new file mode 100644
index 000000000..fa6c7072a
--- /dev/null
+++ b/ui/app/toolkits/qt/platforms/macos/MacOSWindow.mm
@@ -0,0 +1,73 @@
+// Copyright (C) 2026 Workrave contributors
+// All rights reserved.
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+//
+
+#include "MacOSWindow.hh"
+
+#import <Cocoa/Cocoa.h>
+
+namespace
+{
+  // On macOS, Qt's WId is the NSView backing the QWindow.
+  NSWindow *ns_window(WId winid)
+  {
+    if (winid == 0)
+      {
+        return nil;
+      }
+    NSView *view = (__bridge NSView *)reinterpret_cast<void *>(winid);
+    return [view window];
+  }
+} // namespace
+
+namespace MacOSWindow
+{
+  void set_hides_on_deactivate(WId winid, bool hides)
+  {
+    NSWindow *window = ns_window(winid);
+    if (window != nil)
+      {
+        [window setHidesOnDeactivate:hides];
+      }
+  }
+
+  void set_all_spaces_and_raised(WId winid)
+  {
+    NSWindow *window = ns_window(winid);
+    if (window == nil)
+      {
+        return;
+      }
+    // Qt sets FullScreenPrimary on its windows; that is mutually exclusive with
+    // FullScreenAuxiliary, and MoveToActiveSpace is mutually exclusive with
+    // CanJoinAllSpaces. OR-ing in our bits without clearing these makes AppKit
+    // reject the combination (NSException -> abort). Clear conflicts first.
+    // Wrapped defensively: a failed cosmetic window tweak must not abort the app.
+    @try
+      {
+        NSWindowCollectionBehavior behavior = window.collectionBehavior;
+        behavior &= ~(NSWindowCollectionBehaviorFullScreenPrimary | NSWindowCollectionBehaviorFullScreenNone
+                      | NSWindowCollectionBehaviorMoveToActiveSpace);
+        behavior |= NSWindowCollectionBehaviorCanJoinAllSpaces | NSWindowCollectionBehaviorFullScreenAuxiliary;
+        window.collectionBehavior = behavior;
+        [window setLevel:NSStatusWindowLevel];
+      }
+    @catch (NSException *exception)
+      {
+        NSLog(@"workrave: could not set window collection behavior: %@", exception);
+      }
+  }
+} // namespace MacOSWindow
