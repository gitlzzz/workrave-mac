+#include "utils/Paths.hh"
 
 #include "Icon.hh"
 #include "DailyLimitWindow.hh"
@@ -48,6 +52,30 @@ void
 Toolkit::preinit(std::shared_ptr<workrave::config::IConfigurator> config)
 {
   TRACE_ENTRY();
+  init_translations();
+}
+
+void
+Toolkit::init_translations()
+{
+  // The bundled workrave_<locale>.qm files were never loaded: the Qt UI uses
+  // tr(), but no QTranslator was installed, so the UI always stayed English.
+  // Load the catalog for the configured locale (or the system locale). Takes
+  // effect on the next launch, since the widgets are translated as they are built.
+  std::string locale_name = GUIConfig::locale()();
+  QLocale locale = locale_name.empty() ? QLocale::system() : QLocale(QString::fromStdString(locale_name));
+
+  for (const auto &dir: workrave::utils::Paths::get_data_directories())
+    {
+      QString translations_dir = QString::fromStdString((dir / "translations").string());
+      auto *translator = new QTranslator(this);
+      if (translator->load(locale, QStringLiteral("workrave"), QStringLiteral("_"), translations_dir, QStringLiteral(".qm")))
+        {
+          installTranslator(translator);
+          break;
+        }
+      delete translator;
+    }
 }
 
